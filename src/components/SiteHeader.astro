---
import { links } from "../data/site";
---
<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href="/#accueil" aria-label="Loady, accueil">
      <img class="brand-logo" src="/favicon.svg" alt="" width="37" height="37" />
      Loady
    </a>
    <nav class="nav-links" id="primary-navigation" data-nav-links aria-label="Navigation principale">
      <a href="/#comment">Comment ça marche</a>
      <a href="/#fonctionnalites">Fonctionnalités</a>
      <a href="/#plateformes">Plateformes</a>
      <a href="/#installer">Installer</a>
      <a href="/#faq">FAQ</a>
    </nav>
    <div class="nav-actions">
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Changer le thème" title="Changer le thème"></button>
      <a class="button button-primary header-download" href={links.apkArm64} download>Télécharger l’APK <span aria-hidden="true">↗</span></a>
      <button class="menu-toggle" type="button" data-menu-toggle aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="primary-navigation">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
</header>
